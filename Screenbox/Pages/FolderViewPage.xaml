<Page
    x:Class="Screenbox.Pages.FolderViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:commands="using:Screenbox.Commands"
    xmlns:controls="using:Screenbox.Controls"
    xmlns:converters="using:Screenbox.Converters"
    xmlns:ctAnimations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flyouts="using:Screenbox.Flyouts"
    xmlns:helpers="using:Screenbox.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:sbuc="using:Screenbox.UI.Controls"
    xmlns:selectors="using:Screenbox.Selectors"
    xmlns:strings="using:Screenbox.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Screenbox.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/CommandBar.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="FolderGridViewItemMediaCardStyle"
                BasedOn="{StaticResource GridViewItemMediaCardStyle}"
                TargetType="GridViewItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <ListViewItemPresenter
                                x:Name="Root"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                CheckBoxBrush="{ThemeResource GridViewItemCheckBoxBrush}"
                                CheckBrush="{ThemeResource GridViewItemCheckBrush}"
                                CheckMode="{ThemeResource GridViewItemCheckMode}"
                                ContentMargin="{TemplateBinding Padding}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Control.IsTemplateFocusTarget="True"
                                DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                                FocusBorderBrush="{ThemeResource GridViewItemFocusBorderBrush}"
                                FocusSecondaryBorderBrush="{ThemeResource GridViewItemFocusSecondaryBorderBrush}"
                                FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                PlaceholderBackground="{ThemeResource GridViewItemPlaceholderBackground}"
                                PointerOverBackground="{ThemeResource GridViewItemBackgroundPointerOver}"
                                PointerOverForeground="{ThemeResource GridViewItemForegroundPointerOver}"
                                PressedBackground="{ThemeResource GridViewItemBackgroundPressed}"
                                SelectedBackground="{ThemeResource GridViewItemBackgroundSelected}"
                                SelectedDisabledBackground="{ThemeResource GridViewItemBackgroundSelectedDisabled}"
                                SelectedForeground="{ThemeResource GridViewItemForegroundSelected}"
                                SelectedPointerOverBackground="{ThemeResource GridViewItemBackgroundSelectedPointerOver}"
                                SelectedPressedBackground="{ThemeResource GridViewItemBackgroundSelectedPressed}"
                                SelectionCheckMarkVisualEnabled="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <selectors:FolderViewItemContainerStyleSelector
                x:Key="FolderViewItemStyleSelector"
                FolderItemStyle="{StaticResource FolderGridViewItemMediaCardStyle}"
                VideoItemStyle="{StaticResource GridViewItemMediaCardStyle}" />

            <flyouts:MediaMenuFlyout
                x:Key="ItemFlyout"
                AddToQueueCommand="{x:Bind ViewModel.AddToQueueCommand}"
                ContextItem="{x:Bind ViewModel.ContextItem, Mode=OneWay}"
                IsAdvancedModeEnabled="{x:Bind Common.IsAdvancedModeEnabled}"
                PlayCommand="{x:Bind ViewModel.PlayCommand}"
                PlayNextCommand="{x:Bind ViewModel.PlayNextCommand}"
                SelectCommand="{x:Bind ViewModel.Selection.SelectItemCommand}" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="TitleText"
            Grid.Row="0"
            MinHeight="{StaticResource PageHeaderMinHeight}"
            Margin="{StaticResource BottomMediumMargin}"
            Padding="{StaticResource ContentPagePadding}"
            MaxLines="2"
            Style="{StaticResource TitleMediumTextBlockStyle}"
            Text="{x:Bind ViewModel.TitleText}">
            <interactivity:Interaction.Behaviors>
                <behaviors:OverflowTextToolTipBehavior />
            </interactivity:Interaction.Behaviors>
        </TextBlock>

        <muxc:BreadcrumbBar
            x:Name="BreadcrumbBar"
            Grid.Row="1"
            Margin="{StaticResource ContentPagePadding}"
            AccessKey="{x:Bind strings:KeyboardResources.CommandBreadcrumbBarKey}"
            ItemClicked="BreadcrumbBar_OnItemClicked"
            ItemsSource="{x:Bind ViewModel.Breadcrumbs}"
            KeyTipPlacementMode="Right" />

        <controls:SelectionBarControl
            x:Name="SelectionBar"
            Grid.Row="2"
            Margin="{StaticResource ContentPagePadding}"
            ctAnimations:Implicit.HideAnimations="{StaticResource SelectionBarExitImplicitAnimation}"
            ctAnimations:Implicit.ShowAnimations="{StaticResource SelectionBarEntranceImplicitAnimation}"
            AddToQueueButtonCommand="{x:Bind ViewModel.AddSelectedToQueueCommand}"
            CheckBoxCommand="{x:Bind ViewModel.SelectAllOrNoneVideosCommand}"
            CheckBoxIsChecked="{x:Bind ViewModel.AreAllVideosSelected, Mode=OneWay}"
            CheckBoxText="{x:Bind strings:Resources.ItemsSelected(ViewModel.Selection.SelectedCount), Mode=OneWay}"
            CloseButtonCommand="{x:Bind ViewModel.Selection.DisableSelectionModeCommand}"
            IsRemoveButtonVisible="False"
            PlayButtonCommand="{x:Bind ViewModel.PlaySelectedCommand}"
            PlayNextButtonCommand="{x:Bind ViewModel.PlaySelectedNextCommand}"
            Selection="{x:Bind ViewModel.Selection}"
            Visibility="Collapsed" />

        <muxc:ProgressBar
            Grid.Row="3"
            Margin="0,4,0,0"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <GridView
            x:Name="FolderView"
            Grid.Row="3"
            Margin="{StaticResource TopLargeMargin}"
            Padding="{StaticResource GridViewContentPagePadding}"
            ui:ListViewExtensions.Command="{x:Bind ViewModel.ClickCommand}"
            ui:ScrollViewerExtensions.VerticalScrollBarMargin="{x:Bind Common.ScrollBarMargin, Mode=OneWay}"
            ContainerContentChanging="FolderView_OnContainerContentChanging"
            IsItemClickEnabled="True"
            ItemContainerStyleSelector="{StaticResource FolderViewItemStyleSelector}"
            ItemsSource="{x:Bind ViewModel.Items}"
            KeyboardAcceleratorPlacementMode="Hidden"
            Loaded="FolderView_OnLoaded"
            SelectionChanged="FolderView_OnSelectionChanged"
            SelectionMode="None">
            <GridView.Resources>
                <commands:BindableCommand x:Key="MediaListViewItemPlayCommand" Command="{x:Bind ViewModel.PlayCommand}" />
            </GridView.Resources>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:StorageItemViewModel">
                    <controls:CommonGridViewItem
                        Title="{x:Bind Name, Mode=OneWay}"
                        Width="{StaticResource WideGridViewItemWidth}"
                        AutomationProperties.Name="{x:Bind helpers:ItemLabelHelper.FormatAccessibleStorageItemName(IsFile, Name, CaptionText, ItemCount), Mode=OneWay}"
                        CanPlay="{x:Bind IsFile}"
                        Caption="{x:Bind helpers:ItemLabelHelper.GetStorageItemCaption(IsFile, CaptionText, ItemCount), Mode=OneWay}"
                        IsPlaying="{x:Bind Media.IsPlaying, Mode=OneWay}"
                        PlayCommand="{StaticResource MediaListViewItemPlayCommand}"
                        PlayCommandParameter="{x:Bind}"
                        ThumbnailHeight="{StaticResource WideGridViewItemThumbnailHeight}"
                        ThumbnailSource="{x:Bind Media.Thumbnail, Mode=OneWay, FallbackValue={x:Null}}">
                        <controls:CommonGridViewItem.PlaceholderIconSource>
                            <FontIconSource FontSize="{StaticResource WideGridItemPlaceholderIconFontSize}" Glyph="{x:Bind converters:GlyphConverter.ToStorageItemGlyph(StorageItem)}" />
                        </controls:CommonGridViewItem.PlaceholderIconSource>
                    </controls:CommonGridViewItem>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.Footer>
                <Border Height="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
            </GridView.Footer>
            <GridView.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="A"
                    Invoked="SelectDeselectAllKeyboardAccelerator_OnInvoked"
                    Modifiers="Control" />
            </GridView.KeyboardAccelerators>
            <interactivity:Interaction.Behaviors>
                <behaviors:AutoFocusBehavior />
                <behaviors:ListViewContextBehavior
                    ContextItem="{x:Bind ViewModel.ContextItem, Mode=TwoWay}"
                    ContextRequested="FolderView_OnItemContextRequested"
                    Flyout="{StaticResource ItemFlyout}" />
                <behaviors:ListViewSelectionBehavior Selection="{x:Bind ViewModel.Selection}" />
                <behaviors:BringIntoViewWithOffsetBehavior FromBottom="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
                <behaviors:ThumbnailGridViewBehavior />
            </interactivity:Interaction.Behaviors>
        </GridView>

        <sbuc:ContentUnavailableView
            x:Name="NoContentPanel"
            Grid.Row="3"
            Margin="{StaticResource TopLargeMargin}"
            Padding="{StaticResource ContentPagePadding}"
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
            Message="{x:Bind strings:Resources.EmptyFolder}" />

        <interactivity:Interaction.Behaviors>
            <behaviors:GamepadXYNavigationBehavior />
        </interactivity:Interaction.Behaviors>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionModes">
                <VisualState x:Name="Multiple">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.Selection.IsSelectionModeActive, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SelectionBar.Visibility" Value="Visible" />
                        <Setter Target="FolderView.SelectionMode" Value="Multiple" />
                        <Setter Target="FolderView.IsItemClickEnabled" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="NavigationViewStates">
                <VisualState x:Name="Expanded" />
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind Common.NavigationViewDisplayMode, Mode=OneWay}" To="{StaticResource MinimalNavigationViewDisplayMode}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleText.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="BreadcrumbBar.Margin" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="SelectionBar.Margin" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="SelectionBar.DefaultLabelPosition" Value="Collapsed" />
                        <Setter Target="FolderView.Padding" Value="{StaticResource GridViewContentPageMinimalPadding}" />
                        <Setter Target="NoContentPanel.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
