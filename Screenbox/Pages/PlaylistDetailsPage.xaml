<Page
    x:Class="Screenbox.Pages.PlaylistDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:commands="using:Screenbox.Commands"
    xmlns:controls="using:Screenbox.Controls"
    xmlns:ctAnimations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flyouts="using:Screenbox.Flyouts"
    xmlns:helpers="using:Screenbox.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Screenbox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:sbuc="using:Screenbox.UI.Controls"
    xmlns:strings="using:Screenbox.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Loaded="PlaylistDetailsPage_OnLoaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/CommandBar.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <commands:BindableCommand x:Key="PlayCommand" Command="{x:Bind ViewModel.PlayCommand}" />
            <commands:SelectDeselectAllCommand x:Key="SelectDeselectAllCommand" />

            <flyouts:MediaMenuFlyout
                x:Key="ItemFlyout"
                AddToQueueCommand="{x:Bind Common.AddToQueueCommand}"
                ContextItem="{x:Bind ViewModel.ContextMedia, Mode=OneWay}"
                IsAdvancedModeEnabled="{x:Bind Common.IsAdvancedModeEnabled}"
                PlayCommand="{x:Bind ViewModel.PlayCommand}"
                PlayNextCommand="{x:Bind Common.PlayNextCommand}"
                RemoveCommand="{x:Bind ViewModel.RemoveCommand}"
                SelectCommand="{x:Bind ViewModel.Selection.SelectItemCommand}">
                <flyouts:MediaMenuFlyout.AdditionalItems>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.MoveItemUpCommand}"
                        CommandParameter="{x:Bind ViewModel.ContextMedia, Mode=OneWay}"
                        Icon="{ui:FontIcon Glyph=&#xE74A;}"
                        Text="{x:Bind strings:Resources.MoveUp}" />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.MoveItemDownCommand}"
                        CommandParameter="{x:Bind ViewModel.ContextMedia, Mode=OneWay}"
                        Icon="{ui:FontIcon Glyph=&#xE74B;}"
                        Text="{x:Bind strings:Resources.MoveDown}" />
                    <MenuFlyoutItem
                        Command="{x:Bind Common.OpenArtistCommand}"
                        CommandParameter="{x:Bind ViewModel.ContextMedia.MainArtist, Mode=OneWay}"
                        Icon="{ui:FontIcon Glyph=&#xE77B;}"
                        Text="{x:Bind strings:Resources.ShowArtist}"
                        Visibility="{x:Bind ViewModel.ContextMedia.MainArtist, Converter={StaticResource EmptyObjectToVisibilityConverter}, Mode=OneWay}" />
                </flyouts:MediaMenuFlyout.AdditionalItems>
            </flyouts:MediaMenuFlyout>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="BackgroundHost"
            Grid.Row="0"
            Margin="0,-136,0,0"
            FlowDirection="LeftToRight"
            SizeChanged="BackgroundHost_OnSizeChanged" />

        <Grid
            x:Name="Header"
            Grid.Row="0"
            Margin="0,0,0,-80"
            Padding="{StaticResource ContentPagePadding}"
            Canvas.ZIndex="1">
            <Rectangle
                x:Name="BackgroundAcrylic"
                Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                RadiusX="8"
                RadiusY="12"
                Shadow="{StaticResource ElevationThemeShadow}"
                Stroke="{ThemeResource ControlElevationBorderBrush}"
                StrokeThickness="1"
                Translation="0,0,32" />

            <Grid x:Name="ContentContainer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="CoverArt"
                    Grid.Column="0"
                    Width="192"
                    Height="192"
                    Margin="0,0,20,0"
                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    FlowDirection="LeftToRight"
                    Shadow="{StaticResource ElevationThemeShadow}"
                    SizeChanged="CoverArt_OnSizeChanged"
                    Translation="0,0,16">
                    <Grid.Background>
                        <ImageBrush ImageSource="{x:Bind ViewModel.Source.Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid.Background>
                    <Border
                        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource OverlayCornerRadius}"
                        Visibility="{x:Bind ViewModel.Source.Thumbnail, Mode=OneWay, Converter={StaticResource EmptyObjectToVisibilityConverter}, ConverterParameter=true, FallbackValue=Visible}">
                        <FontIcon
                            x:Name="CoverArtIcon"
                            FontFamily="{StaticResource ScreenboxSymbolThemeFontFamily}"
                            FontSize="64"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{StaticResource PlaylistGlyph}" />
                    </Border>
                </Grid>

                <StackPanel
                    x:Name="TextPanel"
                    Grid.Column="1"
                    Orientation="Vertical">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource TitleMediumTextBlockStyle}"
                        Text="{x:Bind ViewModel.Source.Name, Mode=OneWay, FallbackValue=''}"
                        TextWrapping="NoWrap">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:OverflowTextToolTipBehavior />
                        </interactivity:Interaction.Behaviors>
                    </TextBlock>

                    <TextBlock
                        x:Name="CaptionText"
                        Margin="0,20,0,0"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind local:PlaylistDetailsPage.GetSubtext(ViewModel.Source.Items), Mode=OneWay, FallbackValue=''}"
                        TextWrapping="NoWrap">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:OverflowTextToolTipBehavior />
                        </interactivity:Interaction.Behaviors>
                    </TextBlock>

                    <Grid x:Name="ButtonPanel">
                        <sbuc:CommandBarEx
                            x:Name="CommandBar"
                            Margin="-8,8,0,0"
                            HorizontalAlignment="Left"
                            AccessKey="{x:Bind strings:KeyboardResources.CommandMoreOptionsKey}"
                            DefaultLabelPosition="Right"
                            MoreButtonStyle="{StaticResource EllipsisDefaultButtonStyle}">
                            <sbuc:CommandBarEx.Resources>
                                <StaticResource x:Key="CommandBarBackground" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="CommandBarBorderBrushOpen" ResourceKey="ControlFillColorTransparentBrush" />
                                <StaticResource x:Key="CommandBarHighContrastBorder" ResourceKey="ControlFillColorTransparentBrush" />

                                <Thickness x:Key="AppBarEllipsisButtonInnerBorderMargin">4,8,4,8</Thickness>
                                <Thickness x:Key="AppBarButtonContentViewboxMargin">16,16,0,16</Thickness>
                                <Thickness x:Key="AppBarButtonTextLabelOnRightMargin">8,14,16,15</Thickness>
                                <Thickness x:Key="AppBarButtonInnerBorderMargin">4,8,4,8</Thickness>
                            </sbuc:CommandBarEx.Resources>

                            <AppBarButton
                                AccessKey="{x:Bind strings:KeyboardResources.CommandPlayKey}"
                                Command="{x:Bind ViewModel.PlayCommand}"
                                CommandParameter="{x:Bind ViewModel.FirstItem, Mode=OneWay}"
                                Icon="{ui:FontIcon FontFamily={StaticResource ScreenboxSymbolThemeFontFamily},
                                                   Glyph={StaticResource PlayGlyph}}"
                                Label="{x:Bind strings:Resources.Play}"
                                Style="{StaticResource AccentButtonAppBarButtonStyle}">
                                <interactivity:Interaction.Behaviors>
                                    <behaviors:AutoFocusBehavior />
                                </interactivity:Interaction.Behaviors>
                            </AppBarButton>

                            <AppBarButton
                                AccessKey="{x:Bind strings:KeyboardResources.CommandShuffleAndPlayKey}"
                                Command="{x:Bind ViewModel.ShuffleAndPlayCommand}"
                                CommandParameter="{x:Bind ViewModel.Source, Mode=OneWay}"
                                Icon="{ui:FontIcon FontFamily={StaticResource ScreenboxSymbolThemeFontFamily},
                                                   Glyph={StaticResource ShuffleGlyph},
                                                   MirroredWhenRightToLeft=True}"
                                Label="{x:Bind strings:Resources.ShuffleAndPlay}"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}" />

                            <AppBarButton
                                Command="{x:Bind ViewModel.AddFilesCommand}"
                                Icon="{ui:SymbolIcon Symbol=Add}"
                                Label="{x:Bind strings:Resources.AddFiles}"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}" />

                            <AppBarButton
                                Command="{x:Bind RenamePlaylistCommand}"
                                Icon="{ui:SymbolIcon Symbol=Rename}"
                                Label="{x:Bind strings:Resources.Rename}"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}" />

                            <AppBarButton
                                Command="{x:Bind SetPlaylistThumbnailCommand}"
                                Icon="{ui:FontIcon Glyph=&#xEB9F;}"
                                Label="Change cover"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}" />

                            <AppBarButton
                                Command="{x:Bind ResetPlaylistThumbnailCommand}"
                                Icon="{ui:SymbolIcon Symbol=Undo}"
                                Label="Reset cover"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}"
                                Visibility="{x:Bind ViewModel.Source.HasCustomThumbnail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                            <AppBarButton
                                Command="{x:Bind ExportPlaylistCommand}"
                                Label="{x:Bind strings:Resources.Export}"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xEDE1;" MirroredWhenRightToLeft="True" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton
                                Command="{x:Bind DeletePlaylistCommand}"
                                Icon="{ui:SymbolIcon Symbol=Delete}"
                                Label="{x:Bind strings:Resources.Delete}"
                                Style="{StaticResource DefaultButtonAppBarButtonStyle}" />
                        </sbuc:CommandBarEx>

                        <controls:SelectionBarControl
                            x:Name="SelectionBar"
                            Margin="0,8,0,0"
                            ctAnimations:Implicit.HideAnimations="{StaticResource SelectionBarExitImplicitAnimation}"
                            ctAnimations:Implicit.ShowAnimations="{StaticResource SelectionBarEntranceImplicitAnimation}"
                            CheckBoxCommand="{StaticResource SelectDeselectAllCommand}"
                            CheckBoxCommandParameter="{x:Bind ItemList}"
                            CheckBoxIsChecked="{x:Bind ViewModel.Selection.IsAllSelected, Mode=OneWay}"
                            CheckBoxText="{x:Bind strings:Resources.ItemsSelected(ViewModel.Selection.SelectedCount), Mode=OneWay}"
                            CloseButtonCommand="{x:Bind ViewModel.Selection.DisableSelectionModeCommand}"
                            IsAddToQueueButtonVisible="False"
                            IsPlayButtonVisible="False"
                            PlayNextButtonCommand="{x:Bind ViewModel.PlaySelectedNextCommand}"
                            RemoveButtonCommand="{x:Bind ViewModel.RemoveSelectedCommand}"
                            Selection="{x:Bind ViewModel.Selection}"
                            Visibility="Collapsed">
                            <controls:SelectionBarControl.AdditionalCommands>
                                <AppBarButton
                                    Command="{x:Bind ViewModel.MoveSelectedItemUpCommand}"
                                    Icon="{ui:FontIcon Glyph=&#xE74A;}"
                                    Label="{x:Bind strings:Resources.MoveUp}" />
                                <AppBarButton
                                    Command="{x:Bind ViewModel.MoveSelectedItemDownCommand}"
                                    Icon="{ui:FontIcon Glyph=&#xE74B;}"
                                    Label="{x:Bind strings:Resources.MoveDown}" />
                            </controls:SelectionBarControl.AdditionalCommands>
                        </controls:SelectionBarControl>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <ListView
            x:Name="ItemList"
            Grid.Row="1"
            Padding="{StaticResource ContentPagePadding}"
            ui:ListViewExtensions.ItemContainerStretchDirection="Horizontal"
            ui:ScrollViewerExtensions.VerticalScrollBarMargin="{x:Bind GetScrollbarVerticalMargin(Common.ScrollBarMargin), Mode=OneWay}"
            AllowDrop="True"
            CanReorderItems="True"
            DragOver="ItemList_OnDragOver"
            Drop="ItemList_OnDrop"
            IsItemClickEnabled="True"
            ItemsSource="{x:Bind ViewModel.Source.Items, Mode=OneWay}"
            KeyboardAcceleratorPlacementMode="Hidden"
            SelectionMode="None"
            Style="{StaticResource MediaListViewStyle}">
            <ListView.Resources>
                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <controls:MediaListViewItem
                        IsAlbumColumnVisible="True"
                        IsTrackNumberVisible="False"
                        PlayCommand="{StaticResource PlayCommand}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Header>
                <Border x:Name="ListHeaderPadding" Height="112" />
            </ListView.Header>
            <ListView.Footer>
                <Border Height="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
            </ListView.Footer>
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="A"
                    Invoked="SelectDeselectAllKeyboardAccelerator_OnInvoked"
                    Modifiers="Control" />
            </ListView.KeyboardAccelerators>
            <interactivity:Interaction.Behaviors>
                <behaviors:AlternatingListViewBehavior
                    AlternateBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    AlternateBorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    AlternateBorderThickness="1" />
                <behaviors:ListViewContextBehavior ContextItem="{x:Bind ViewModel.ContextMedia, Mode=TwoWay}" Flyout="{StaticResource ItemFlyout}" />
                <behaviors:ListViewSelectionBehavior Selection="{x:Bind ViewModel.Selection}" />
                <behaviors:BringIntoViewWithOffsetBehavior FromBottom="{x:Bind Common.FooterBottomPaddingHeight, Mode=OneWay}" />
                <behaviors:FocusOnItemClickBehavior />
            </interactivity:Interaction.Behaviors>
        </ListView>

        <sbuc:ContentUnavailableView
            x:Name="NoPlaylistItemsView"
            Grid.Row="1"
            IsOpen="False"
            Message="{x:Bind strings:Resources.NoPlaylistItems}" />

        <interactivity:Interaction.Behaviors>
            <behaviors:GamepadXYNavigationBehavior />
        </interactivity:Interaction.Behaviors>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionModes">
                <VisualState x:Name="Multiple">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.Selection.IsSelectionModeActive, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommandBar.Visibility" Value="Collapsed" />
                        <Setter Target="SelectionBar.Visibility" Value="Visible" />
                        <Setter Target="ItemList.SelectionMode" Value="Multiple" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="NavigationViewStates">
                <VisualState x:Name="Expanded" />
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind Common.NavigationViewDisplayMode, Mode=OneWay}" To="{StaticResource MinimalNavigationViewDisplayMode}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Header.Margin" Value="0,0,0,-48" />
                        <Setter Target="Header.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="CoverArt.Width" Value="160" />
                        <Setter Target="CoverArt.Height" Value="160" />
                        <Setter Target="CoverArtIcon.FontSize" Value="52" />
                        <Setter Target="ItemList.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="ListHeaderPadding.Height" Value="72" />
                        <Setter Target="SelectionBar.DefaultLabelPosition" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ContentStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="NoContent">
                    <VisualState.StateTriggers>
                        <ui:IsNullOrEmptyStateTrigger Value="{x:Bind ViewModel.Source.Items, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NoPlaylistItemsView.IsOpen" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
